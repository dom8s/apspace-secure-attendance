@* ── Sessions.cshtml ── *@
@model List<SessionViewModel>
@{ ViewData["Title"] = "My Sessions"; }

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <div class="page-title">My Sessions</div>
        <div class="page-subtitle">All attendance sessions you have created</div>
    </div>
    <a href="/Lecturer/CreateSession" class="btn-accent">
        <i class="bi bi-plus-lg me-1"></i> New Session
    </a>
</div>

<div class="card-dark">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:var(--text-muted)">
            <i class="bi bi-calendar-x" style="font-size:2.5rem;display:block;margin-bottom:10px"></i>
            No sessions found.
            <a href="/Lecturer/CreateSession" style="color:var(--accent)">Create your first session.</a>
        </div>
    }
    else
    {
        <table class="table-dark-custom">
            <thead>
                <tr><th>Session Code</th><th>Subject</th><th>Created</th><th>Expires</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <code style="color:var(--accent);font-size:1.2rem;font-weight:700;letter-spacing:6px">
                                @s.SessionCode
                            </code>
                        </td>
                        <td>
                            <div>@s.SubjectCode</div>
                            <div style="font-size:0.75rem;color:var(--text-muted)">@s.SubjectName</div>
                        </td>
                        <td style="color:var(--text-muted);font-size:0.8rem">@s.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td style="color:var(--text-muted);font-size:0.8rem">@s.ExpiresAt.ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            @if (s.IsActive && s.ExpiresAt > DateTime.UtcNow)
                            {
                                <span class="badge-active">● Active</span>
                            }
                            else
                            {
                                <span class="badge-closed">Closed</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="/Lecturer/SessionDetail?id=@s.SessionId" class="btn-outline-accent">
                                    Details
                                </a>
                                @if (s.IsActive)
                                {
                                    <form method="post" action="/Lecturer/CloseSession" style="display:inline">
                                        <input type="hidden" name="sessionId" value="@s.SessionId" />
                                        <button type="submit" class="btn-outline-accent"
                                                style="color:var(--danger);border-color:var(--danger)"
                                                onclick="return confirm('Close this session?')">
                                            Close
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
