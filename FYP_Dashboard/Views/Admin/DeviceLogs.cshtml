@model List<DeviceLogViewModel>
@{ ViewData["Title"] = "Device Logs"; }

<div class="page-header d-flex justify-content-between align-items-start">
    <div>
        <div class="page-title">Device Logs</div>
        <div class="page-subtitle">Device fingerprint usage audit trail</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/DeviceLogs?flaggedOnly=false"
           class="btn-outline-accent @(ViewBag.FlaggedOnly == false ? "" : "")">
            All Logs
        </a>
        <a href="/Admin/DeviceLogs?flaggedOnly=true" class="btn-outline-accent">
            Flagged Only
        </a>
    </div>
</div>

<div class="card-dark">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:var(--text-muted)">
            <i class="bi bi-phone" style="font-size:2.5rem;display:block;margin-bottom:10px"></i>
            No device logs found.
        </div>
    }
    else
    {
        <table class="table-dark-custom">
            <thead>
                <tr>
                    <th>Device Fingerprint</th>
                    <th>Student</th>
                    <th>Session</th>
                    <th>Flagged</th>
                    <th>Reason</th>
                    <th>Reviewed</th>
                    <th>Logged</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>
                            <code style="font-size:0.72rem;color:var(--accent)">
                                @log.DeviceFingerprint.Substring(0, Math.Min(16, log.DeviceFingerprint.Length))...
                            </code>
                        </td>
                        <td>
                            <div style="font-weight:600">@log.TPNumber</div>
                            <div style="font-size:0.75rem;color:var(--text-muted)">@log.StudentName</div>
                        </td>
                        <td><code style="color:var(--accent)">@log.SessionCode</code></td>
                        <td>
                            @if (log.IsFlagged)
                            {
                                <span class="badge-flagged">⚠ Yes</span>
                            }
                            else
                            {
                                <span class="badge-accepted">✓ No</span>
                            }
                        </td>
                        <td style="font-size:0.78rem;color:var(--text-muted);max-width:160px">
                            @(log.FlagReason ?? "—")
                        </td>
                        <td>
                            @if (log.ReviewedByAdmin)
                            {
                                <span class="badge-accepted">✓ Reviewed</span>
                            }
                            else
                            {
                                <span class="badge-closed">Pending</span>
                            }
                        </td>
                        <td style="font-size:0.78rem;color:var(--text-muted)">
                            @log.LoggedAt.ToString("dd MMM HH:mm")
                        </td>
                        <td>
                            @if (log.IsFlagged && !log.ReviewedByAdmin)
                            {
                                <a href="/Admin/Review?logId=@log.LogId" class="btn-outline-accent">
                                    Review
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(log.AdminNotes))
                            {
                                <span style="font-size:0.75rem;color:var(--text-muted)"
                                      title="@log.AdminNotes">
                                    <i class="bi bi-chat-text-fill"></i> Notes
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
