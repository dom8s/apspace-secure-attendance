<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — APSpace Secure Attendance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --bg-dark:    #0d0d0d;
            --bg-card:    #1a1a1a;
            --bg-sidebar: #111111;
            --accent:     #f5a623;
            --accent-dim: #c4811c;
            --text-main:  #f0f0f0;
            --text-muted: #888888;
            --border:     #2a2a2a;
            --success:    #4caf50;
            --danger:     #f44336;
            --warning:    #ff9800;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
        }

        /* ── Sidebar ── */
        .sidebar {
            width: 240px;
            min-height: 100vh;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 0; left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 20px 16px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-brand .brand-text {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--accent);
            letter-spacing: 1px;
        }

        .sidebar-brand .brand-sub {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 12px 0;
        }

        .nav-section-label {
            font-size: 0.65rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 12px 16px 4px;
        }

        .sidebar-nav .nav-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.875rem;
            border-left: 3px solid transparent;
            transition: all 0.2s;
        }

        .sidebar-nav .nav-link:hover,
        .sidebar-nav .nav-link.active {
            color: var(--text-main);
            background: rgba(245,166,35,0.08);
            border-left-color: var(--accent);
        }

        .sidebar-nav .nav-link i { font-size: 1rem; }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--border);
        }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .user-avatar {
            width: 34px; height: 34px;
            background: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
            color: #000;
            flex-shrink: 0;
        }

        .user-name  { font-size: 0.8rem; font-weight: 600; }
        .user-role  { font-size: 0.7rem; color: var(--text-muted); }

        .btn-logout {
            width: 100%;
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 6px;
            border-radius: 6px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            border-color: var(--danger);
            color: var(--danger);
        }

        /* ── Main content ── */
        .main-content {
            margin-left: 240px;
            padding: 28px;
            min-height: 100vh;
        }

        /* ── Cards ── */
        .card-dark {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
        }

        /* ── Stat cards ── */
        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 4px;
            height: 100%;
        }

        .stat-card.accent::before  { background: var(--accent); }
        .stat-card.success::before { background: var(--success); }
        .stat-card.danger::before  { background: var(--danger); }
        .stat-card.warning::before { background: var(--warning); }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1;
        }

        .stat-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            font-size: 2rem;
            opacity: 0.15;
            position: absolute;
            right: 16px;
            top: 16px;
        }

        /* ── Page header ── */
        .page-header {
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .page-subtitle {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* ── Tables ── */
        .table-dark-custom {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .table-dark-custom th {
            background: #111;
            color: var(--text-muted);
            padding: 10px 14px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }

        .table-dark-custom td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
            vertical-align: middle;
        }

        .table-dark-custom tr:hover td {
            background: rgba(255,255,255,0.02);
        }

        /* ── Badges ── */
        .badge-accepted { background: rgba(76,175,80,0.15);  color: #4caf50; padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; }
        .badge-flagged  { background: rgba(255,152,0,0.15);  color: #ff9800; padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; }
        .badge-rejected { background: rgba(244,67,54,0.15);  color: #f44336; padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; }
        .badge-active   { background: rgba(245,166,35,0.15); color: #f5a623; padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; }
        .badge-closed   { background: rgba(136,136,136,0.15);color: #888;    padding: 3px 8px; border-radius: 20px; font-size: 0.75rem; }

        /* ── Buttons ── */
        .btn-accent {
            background: var(--accent);
            color: #000;
            border: none;
            font-weight: 600;
            border-radius: 6px;
            padding: 8px 16px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-accent:hover { background: var(--accent-dim); }

        .btn-outline-accent {
            background: transparent;
            color: var(--accent);
            border: 1px solid var(--accent);
            border-radius: 6px;
            padding: 6px 14px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-outline-accent:hover {
            background: var(--accent);
            color: #000;
        }

        /* ── Form controls ── */
        .form-control-dark {
            background: #222;
            border: 1px solid var(--border);
            color: var(--text-main);
            border-radius: 6px;
            padding: 8px 12px;
            width: 100%;
            font-size: 0.875rem;
        }

        .form-control-dark:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 2px rgba(245,166,35,0.2);
        }

        .form-label-dark {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            display: block;
        }

        /* ── Session code display ── */
        .session-code {
            font-size: 3rem;
            font-weight: 900;
            color: var(--accent);
            letter-spacing: 12px;
            text-align: center;
            padding: 20px;
            background: rgba(245,166,35,0.05);
            border: 2px dashed var(--accent);
            border-radius: 12px;
        }

        /* ── Alert boxes ── */
        .alert-dark-success {
            background: rgba(76,175,80,0.1);
            border: 1px solid rgba(76,175,80,0.3);
            color: #4caf50;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.875rem;
        }

        .alert-dark-danger {
            background: rgba(244,67,54,0.1);
            border: 1px solid rgba(244,67,54,0.3);
            color: #f44336;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.875rem;
        }

        /* ── Progress bar ── */
        .progress-dark {
            background: var(--border);
            border-radius: 10px;
            height: 6px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--accent);
            border-radius: 10px;
            transition: width 0.5s;
        }
    </style>
</head>
<body>

@{
    var role     = Context.Session.GetString("Role")     ?? "";
    var fullName = Context.Session.GetString("FullName") ?? "";
    var tpNumber = Context.Session.GetString("TPNumber") ?? "";
    var initial  = fullName.Length > 0 ? fullName[0].ToString() : "U";
    var currentPath = Context.Request.Path.Value ?? "";
}

@if (!string.IsNullOrEmpty(role))
{
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-text">APSpace</div>
            <div class="brand-sub">Secure Attendance System</div>
        </div>

        <nav class="sidebar-nav">
            @if (role == "Admin")
            {
                <div class="nav-section-label">Admin Panel</div>
                <a class="nav-link @(currentPath.Contains("/Admin/Dashboard") ? "active" : "")"
                   href="/Admin/Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(currentPath.Contains("/Admin/Flagged") ? "active" : "")"
                   href="/Admin/Flagged">
                    <i class="bi bi-flag-fill"></i> Flagged Attendance
                </a>
                <a class="nav-link @(currentPath.Contains("/Admin/DeviceLogs") ? "active" : "")"
                   href="/Admin/DeviceLogs">
                    <i class="bi bi-phone-fill"></i> Device Logs
                </a>
                <a class="nav-link @(currentPath.Contains("/Admin/Summary") ? "active" : "")"
                   href="/Admin/Summary">
                    <i class="bi bi-bar-chart-fill"></i> Attendance Summary
                </a>
            }
            else if (role == "Lecturer")
            {
                <div class="nav-section-label">Lecturer Panel</div>
                <a class="nav-link @(currentPath == "/Lecturer/Dashboard" ? "active" : "")"
                   href="/Lecturer/Dashboard">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(currentPath.Contains("/Lecturer/Sessions") ? "active" : "")"
                   href="/Lecturer/Sessions">
                    <i class="bi bi-calendar3"></i> My Sessions
                </a>
                <a class="nav-link @(currentPath.Contains("/Lecturer/CreateSession") ? "active" : "")"
                   href="/Lecturer/CreateSession">
                    <i class="bi bi-plus-circle-fill"></i> Create Session
                </a>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="user-chip">
                <div class="user-avatar">@initial</div>
                <div>
                    <div class="user-name">@fullName</div>
                    <div class="user-role">@role · @tpNumber</div>
                </div>
            </div>
            <a href="/Auth/Logout">
                <button class="btn-logout">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </a>
        </div>
    </div>
}

<!-- Main Content -->
<div class="main-content" style="@(string.IsNullOrEmpty(role) ? "margin-left:0" : "")">
    @if (TempData["Success"] != null)
    {
        <div class="alert-dark-success mb-3">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        </div>
    }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
