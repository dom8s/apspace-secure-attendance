@model LoginViewModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Login — APSpace Secure Attendance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
    <style>
        body {
            background: #0d0d0d;
            color: #f0f0f0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }

        .brand { text-align: center; margin-bottom: 32px; }

        .brand-logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: #f5a623;
            letter-spacing: 2px;
        }

        .brand-logo span { color: #f0f0f0; }

        .brand-sub {
            font-size: 0.75rem;
            color: #888;
            margin-top: 4px;
        }

        .form-label { font-size: 0.8rem; color: #888; margin-bottom: 6px; }

        .form-control {
            background: #222;
            border: 1px solid #2a2a2a;
            color: #f0f0f0;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.875rem;
        }

        .form-control:focus {
            background: #222;
            border-color: #f5a623;
            color: #f0f0f0;
            box-shadow: 0 0 0 2px rgba(245,166,35,0.2);
        }

        .form-control::placeholder { color: #555; }

        .btn-login {
            width: 100%;
            background: #f5a623;
            color: #000;
            font-weight: 700;
            border: none;
            border-radius: 8px;
            padding: 11px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 8px;
        }

        .btn-login:hover { background: #c4811c; }

        .error-box {
            background: rgba(244,67,54,0.1);
            border: 1px solid rgba(244,67,54,0.3);
            color: #f44336;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.8rem;
            margin-bottom: 16px;
        }

        .divider {
            border: none;
            border-top: 1px solid #2a2a2a;
            margin: 28px 0 20px;
        }

        .access-note {
            font-size: 0.72rem;
            color: #555;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="login-card">
    <div class="brand">
        <div class="brand-logo">AP<span>Space</span></div>
        <div class="brand-sub">Secure Attendance — Admin &amp; Lecturer Portal</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error-box">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        </div>
    }

    <form method="post">
        <div class="mb-3">
            <label class="form-label">TP Number / Staff ID</label>
            <input asp-for="TPNumber"
                   class="form-control"
                   placeholder="e.g. STAFF001 or ADMIN001"
                   autocomplete="username" />
        </div>
        <div class="mb-4">
            <label class="form-label">Password</label>
            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Enter your password"
                   autocomplete="current-password" />
        </div>
        <button type="submit" class="btn-login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>
    </form>

    <hr class="divider"/>
    <p class="access-note">
        <i class="bi bi-lock-fill me-1"></i>
        Access restricted to Admins and Lecturers only.
    </p>
</div>
</body>
</html>
